{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": [
        "src/app.*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./features/**",
                  "!./features/features.manifest.ts"
                ],
                "message": "main uses the features only through the manifest."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/core/*.ts",
        "src/core/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../features/**",
                  "../app.*.ts"
                ],
                "message": "core never uses a feature, the manifest or main. The composition connects them."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/features.manifest.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../app.*.ts",
                  "./*/*.api.ts",
                  "./*/*.api.vue",
                  "./*/*.service.ts",
                  "./*/*.service.vue",
                  "./*/*.policy.ts",
                  "./*/*.policy.vue",
                  "./*/*.store.ts",
                  "./*/*.store.vue",
                  "./*/*.repository.ts",
                  "./*/*.repository.vue",
                  "./*/*.client.ts",
                  "./*/*.client.vue"
                ],
                "message": "The manifest uses only the presentation (the registration) of each feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.ts",
        "src/features/*/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.controller.ts",
        "src/features/*/*.controller.vue",
        "src/features/*/*.request.ts",
        "src/features/*/*.request.vue",
        "src/features/*/*.command.ts",
        "src/features/*/*.command.vue",
        "src/features/*/*.page.ts",
        "src/features/*/*.page.vue",
        "src/features/*/*.component.ts",
        "src/features/*/*.component.vue",
        "src/features/*/*.card.ts",
        "src/features/*/*.card.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.repository.ts",
                  "./*.repository.vue",
                  "./*.client.ts",
                  "./*.client.vue"
                ],
                "message": "presentation never uses data: only the registration (routes) creates it for logic. The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.api.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.routes.ts",
                  "./*.routes.vue",
                  "./*.controller.ts",
                  "./*.controller.vue",
                  "./*.request.ts",
                  "./*.request.vue",
                  "./*.command.ts",
                  "./*.command.vue",
                  "./*.page.ts",
                  "./*.page.vue",
                  "./*.component.ts",
                  "./*.component.vue",
                  "./*.card.ts",
                  "./*.card.vue",
                  "./*.repository.ts",
                  "./*.repository.vue",
                  "./*.client.ts",
                  "./*.client.vue"
                ],
                "message": "The facade never uses presentation or data. The direction is facade → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.service.ts",
        "src/features/*/*.service.vue",
        "src/features/*/*.policy.ts",
        "src/features/*/*.policy.vue",
        "src/features/*/*.store.ts",
        "src/features/*/*.store.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.routes.ts",
                  "./*.routes.vue",
                  "./*.controller.ts",
                  "./*.controller.vue",
                  "./*.request.ts",
                  "./*.request.vue",
                  "./*.command.ts",
                  "./*.command.vue",
                  "./*.page.ts",
                  "./*.page.vue",
                  "./*.component.ts",
                  "./*.component.vue",
                  "./*.card.ts",
                  "./*.card.vue",
                  "./*.api.ts"
                ],
                "message": "logic never uses presentation or the facade. The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.repository.ts",
        "src/features/*/*.repository.vue",
        "src/features/*/*.client.ts",
        "src/features/*/*.client.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.routes.ts",
                  "./*.routes.vue",
                  "./*.controller.ts",
                  "./*.controller.vue",
                  "./*.request.ts",
                  "./*.request.vue",
                  "./*.command.ts",
                  "./*.command.vue",
                  "./*.page.ts",
                  "./*.page.vue",
                  "./*.component.ts",
                  "./*.component.vue",
                  "./*.card.ts",
                  "./*.card.vue",
                  "./*.service.ts",
                  "./*.service.vue",
                  "./*.policy.ts",
                  "./*.policy.vue",
                  "./*.store.ts",
                  "./*.store.vue",
                  "./*.api.ts"
                ],
                "message": "data never uses presentation, logic or the facade. The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/*.ts",
        "src/shared/*.vue",
        "src/shared/*/*.ts",
        "src/shared/*/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../app.*.ts",
                  "../../core/**",
                  "../../features/**",
                  "../../app.*.ts"
                ],
                "message": "shared uses no part of the application: no core, features or main."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ]
}
