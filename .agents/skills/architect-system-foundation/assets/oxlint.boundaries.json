{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": [
        "src/main.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./features/**",
                  "./shared/**"
                ],
                "message": "main uses core only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/core/*.ts",
        "src/core/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../features/**",
                  "!../features/manifest.ts",
                  "../main.ts"
                ],
                "message": "core uses the manifest and shared only. It never uses a feature directly."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/manifest.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*/*",
                  "!./*/index.ts",
                  "../core/**",
                  "../main.ts"
                ],
                "message": "The manifest uses only the facade (index.ts) of each feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.ts",
        "src/features/*/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../main.ts",
                  "../manifest.ts"
                ],
                "message": "Features never use core, main or the manifest. They get configuration by injection."
              },
              {
                "group": [
                  "../*/*",
                  "!../*/index.ts"
                ],
                "message": "A feature uses a different feature only through its facade (index.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.service.ts",
        "src/features/*/*.service.vue",
        "src/features/*/*.store.ts",
        "src/features/*/*.store.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../main.ts",
                  "../manifest.ts"
                ],
                "message": "Features never use core, main or the manifest. They get configuration by injection."
              },
              {
                "group": [
                  "../*/*",
                  "!../*/index.ts"
                ],
                "message": "A feature uses a different feature only through its facade (index.ts)."
              },
              {
                "group": [
                  "*.routes.ts",
                  "*.middleware.ts",
                  "*.page.ts",
                  "*.page.vue",
                  "*.component.ts",
                  "*.component.vue",
                  "*.command.ts"
                ],
                "message": "Logic never uses presentation (.routes, .middleware, .page, .component, .command). The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.repository.ts",
        "src/features/*/*.repository.vue",
        "src/features/*/*.client.ts",
        "src/features/*/*.client.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../main.ts",
                  "../manifest.ts"
                ],
                "message": "Features never use core, main or the manifest. They get configuration by injection."
              },
              {
                "group": [
                  "../*/*",
                  "!../*/index.ts"
                ],
                "message": "A feature uses a different feature only through its facade (index.ts)."
              },
              {
                "group": [
                  "*.routes.ts",
                  "*.middleware.ts",
                  "*.page.ts",
                  "*.page.vue",
                  "*.component.ts",
                  "*.component.vue",
                  "*.command.ts"
                ],
                "message": "Data never uses presentation (.routes, .middleware, .page, .component, .command). The direction is presentation → logic → data."
              },
              {
                "group": [
                  "*.service.ts",
                  "*.store.ts"
                ],
                "message": "Data never uses logic (.service, .store). The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/*.ts",
        "src/shared/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../main.ts"
                ],
                "message": "shared uses nothing of the application: no core, features or main."
              },
              {
                "group": [
                  "*.routes.ts",
                  "*.middleware.ts",
                  "*.page.ts",
                  "*.page.vue",
                  "*.component.ts",
                  "*.component.vue",
                  "*.command.ts",
                  "*.service.ts",
                  "*.store.ts",
                  "*.repository.ts",
                  "*.client.ts"
                ],
                "message": "A shared primitive (a file with no layer suffix) depends on nothing. All layers can use it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/*.types.ts",
        "src/shared/*.types.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../main.ts"
                ],
                "message": "shared uses nothing of the application: no core, features or main."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/*.routes.ts",
        "src/shared/*.routes.vue",
        "src/shared/*.middleware.ts",
        "src/shared/*.middleware.vue",
        "src/shared/*.page.ts",
        "src/shared/*.page.vue",
        "src/shared/*.component.ts",
        "src/shared/*.component.vue",
        "src/shared/*.command.ts",
        "src/shared/*.command.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../main.ts"
                ],
                "message": "shared uses nothing of the application: no core, features or main."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/*.service.ts",
        "src/shared/*.service.vue",
        "src/shared/*.store.ts",
        "src/shared/*.store.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../main.ts"
                ],
                "message": "shared uses nothing of the application: no core, features or main."
              },
              {
                "group": [
                  "*.routes.ts",
                  "*.middleware.ts",
                  "*.page.ts",
                  "*.page.vue",
                  "*.component.ts",
                  "*.component.vue",
                  "*.command.ts"
                ],
                "message": "Logic never uses presentation (.routes, .middleware, .page, .component, .command). The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/*.repository.ts",
        "src/shared/*.repository.vue",
        "src/shared/*.client.ts",
        "src/shared/*.client.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../main.ts"
                ],
                "message": "shared uses nothing of the application: no core, features or main."
              },
              {
                "group": [
                  "*.routes.ts",
                  "*.middleware.ts",
                  "*.page.ts",
                  "*.page.vue",
                  "*.component.ts",
                  "*.component.vue",
                  "*.command.ts"
                ],
                "message": "Data never uses presentation (.routes, .middleware, .page, .component, .command). The direction is presentation → logic → data."
              },
              {
                "group": [
                  "*.service.ts",
                  "*.store.ts"
                ],
                "message": "Data never uses logic (.service, .store). The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ]
}
