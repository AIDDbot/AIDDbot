{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": [
        "src/app.*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./features/**",
                  "!./features/features.manifest.ts"
                ],
                "message": "main uses the features only through the manifest."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/core/*.ts",
        "src/core/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../features/**",
                  "../app.*.ts"
                ],
                "message": "core never uses a feature, the manifest or main. main gives data to core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/features.manifest.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*/*.ts",
                  "./*/*.vue",
                  "!./*/*.api.ts",
                  "../core/**",
                  "../app.*.ts"
                ],
                "message": "The manifest uses only the facade ({feature}.api.ts) of each feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.ts",
        "src/features/*/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "!../../core/core.api.ts",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature uses only the public file of core (core.api.ts), or gets the services by injection. It never uses main or the manifest."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.service.ts",
        "src/features/*/*.service.vue",
        "src/features/*/*.policy.ts",
        "src/features/*/*.policy.vue",
        "src/features/*/*.store.ts",
        "src/features/*/*.store.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "!../../core/core.api.ts",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature uses only the public file of core (core.api.ts), or gets the services by injection. It never uses main or the manifest."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.controller.ts",
                  "./*.controller.vue",
                  "./*.request.ts",
                  "./*.request.vue",
                  "./*.command.ts",
                  "./*.command.vue",
                  "./*.page.ts",
                  "./*.page.vue",
                  "./*.component.ts",
                  "./*.component.vue",
                  "./*.api.ts"
                ],
                "message": "logic never uses presentation or the facade. The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/*.repository.ts",
        "src/features/*/*.repository.vue",
        "src/features/*/*.client.ts",
        "src/features/*/*.client.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "!../../core/core.api.ts",
                  "../../app.*.ts",
                  "../features.manifest.ts"
                ],
                "message": "A feature uses only the public file of core (core.api.ts), or gets the services by injection. It never uses main or the manifest."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.vue",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.controller.ts",
                  "./*.controller.vue",
                  "./*.request.ts",
                  "./*.request.vue",
                  "./*.command.ts",
                  "./*.command.vue",
                  "./*.page.ts",
                  "./*.page.vue",
                  "./*.component.ts",
                  "./*.component.vue",
                  "./*.service.ts",
                  "./*.service.vue",
                  "./*.policy.ts",
                  "./*.policy.vue",
                  "./*.store.ts",
                  "./*.store.vue",
                  "./*.api.ts"
                ],
                "message": "data never uses presentation, logic or the facade. The direction is presentation → logic → data."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/shared/*.ts",
        "src/shared/*.vue",
        "src/shared/*/*.ts",
        "src/shared/*/*.vue"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../app.*.ts",
                  "../../core/**",
                  "../../features/**",
                  "../../app.*.ts"
                ],
                "message": "shared uses no part of the application: no core, features or main."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ]
}
