{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./.oxlintrc.json"
  ],
  "rules": {
    "eslint/complexity": [
      "warn",
      {
        "max": 8
      }
    ],
    "eslint/max-lines-per-function": [
      "warn",
      {
        "max": 32,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/max-depth": [
      "warn",
      {
        "max": 2
      }
    ],
    "eslint/max-params": [
      "warn",
      {
        "max": 3
      }
    ],
    "eslint/max-lines": [
      "warn",
      {
        "max": 128,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts"
      ],
      "rules": {
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": [
          "warn",
          {
            "max": 64
          }
        ],
        "eslint/max-depth": [
          "warn",
          {
            "max": 4
          }
        ],
        "eslint/max-params": [
          "warn",
          {
            "max": 4
          }
        ],
        "eslint/max-lines": [
          "warn",
          {
            "max": 256,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
