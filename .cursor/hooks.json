{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .agents/hooks/index.mjs ingest cursor sessionStart"
      }
    ],
    "sessionEnd": [
      {
        "command": "node .agents/hooks/index.mjs ingest cursor sessionEnd"
      }
    ],
    "subagentStart": [
      {
        "command": "node .agents/hooks/index.mjs ingest cursor subagentStart"
      }
    ],
    "subagentStop": [
      {
        "command": "node .agents/hooks/index.mjs ingest cursor subagentStop"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .agents/hooks/index.mjs ingest cursor beforeSubmitPrompt"
      }
    ],
    "stop": [
      {
        "command": "node .agents/hooks/index.mjs ingest cursor stop"
      }
    ]
  }
}
